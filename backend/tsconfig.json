{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext", // ALTERADO para o padrão moderno
    "moduleResolution": "NodeNext", // ADICIONADO para resolver o conflito
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}